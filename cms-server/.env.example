# Copy to .env only for local development. Never commit a real .env file.
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PUBLIC_API_URL=http://127.0.0.1:3000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
MAX_UPLOAD_MB=5
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-public-website-repository
GITHUB_BRANCH=main
GITHUB_TOKEN=replace-with-fine-grained-token
